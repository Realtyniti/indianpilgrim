# indianpilgrim.com — Apache config for Hostinger shared hosting
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the www host (single canonical origin for SEO)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.indianpilgrim.com/$1 [R=301,L]

# Short / alternate URLs → canonical hub pages
RewriteRule ^(chardham-yatra|char-dham)/?$ /char-dham-yatra/ [R=301,L]
RewriteRule ^do-dham/?$ /do-dham-yatra/ [R=301,L]
RewriteRule ^vaishno-devi/?$ /vaishno-devi-yatra/ [R=301,L]
RewriteRule ^kedarnath/?$ /kedarnath-yatra/ [R=301,L]
RewriteRule ^badrinath/?$ /badrinath-yatra/ [R=301,L]

# Add the trailing slash to directory URLs (/char-dham-yatra → /char-dham-yatra/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType image/png "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# The social-share image is exported without a file extension
<Files "opengraph-image">
ForceType image/png
</Files>
